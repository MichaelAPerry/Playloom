{
  "name": "playloom",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source motion gaming console, engine and game maker",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @playloom/console dev",
    "dev:playground": "pnpm --filter @playloom/playground dev",
    "build": "pnpm --filter @playloom/console build && pnpm --filter @playloom/playground build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fetch-models": "node scripts/fetch-models.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}

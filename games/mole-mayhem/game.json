          "layer": 5
        }
      ],
      "rules": [
        {
          "name": "A mole pops up",
          "when": {
            "type": "every",
            "seconds": 0.7,
            "jitter": 0.25
          },
          "then": [
            {
              "do": "show",
              "object": {
                "random": {
                  "tag": "mole",
                  "state": "hidden"
                }
              },
              "forSeconds": 1.6
            }
          ]
        },
        {
          "name": "A gold star appears",
          "when": {
            "type": "every",
            "seconds": 5,
            "jitter": 1.5
          },
          "then": [
            {
              "do": "show",
              "object": {
                "random": {
                  "tag": "gold",
                  "state": "hidden"
                }
              },
              "forSeconds": 1.1
            },
            {
              "do": "play-sound",
              "sound": "tick"
            }
          ]
        },
        {
          "name": "Hide the hint",
          "when": {
            "type": "every",
            "seconds": 6
          },
          "then": [
            {
              "do": "hide",
              "object": "hint"
            }
          ]
        },
        {
          "name": "A player bonks a mole",
          "when": {
            "type": "hand-touches",
            "player": "any",
            "object": {
              "tag": "mole"
            }
          },
          "then": [
            {
              "do": "add-score",
              "player": "$player",
              "amount": 10
            },
            {
              "do": "effect",
              "object": "$object",
              "effect": "burst"
            },
            {
              "do": "hide",
              "object": "$object"
            },
            {
              "do": "play-sound",
              "sound": "bonk"
            }
          ]
        },
        {
          "name": "A player catches a gold star",
          "when": {
            "type": "hand-touches",
            "player": "any",
            "object": {
              "tag": "gold"
            }
          },
          "then": [
            {
              "do": "add-score",
              "player": "$player",
              "amount": 30
            },
            {
              "do": "effect",
              "object": "$object",
              "effect": "burst"
            },
            {
              "do": "hide",
              "object": "$object"
            },
            {
              "do": "play-sound",
              "sound": "ding"
            }
          ]
        },
        {
          "name": "Time is up",
          "when": {
            "type": "timer-ends",
            "timer": "clock"
          },
          "then": [
            {
              "do": "play-sound",
              "sound": "win"
            },
            {
              "do": "end-game",
              "result": "highest-score"
            }
          ]
        }
      ],
      "backgroundImage": "background"
    }
  ]
